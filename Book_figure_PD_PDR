def eval_orthonormal_legendre_1d(x, n_max):
    x = np.asarray(x).flatten()
    P = np.zeros((len(x), n_max + 1))
    P[:, 0] = 1.0
    if n_max > 0:
        P[:, 1] = np.sqrt(3) * x
    for n in range(1, n_max):
        a_n = np.sqrt((2*n + 3) / (2*n + 1)) * (2*n + 1) / (n + 1)
        b_n = np.sqrt((2*n + 3) / (2*n - 1)) * n / (n + 1)
        P[:, n + 1] = a_n * x * P[:, n] - b_n * P[:, n-1]
    return P

def generate_hyperbolic_cross_corrected(d, n_hc):
    indices = []
    for alpha in itertools.product(*[range(n_hc + 1) for _ in range(d)]):
        if np.prod(np.array(alpha) + 1) <= n_hc:
            indices.append(alpha)
    return np.array(indices)

def f1(y, d):
    return np.exp(-1/(2*d) * np.sum(y, axis=1))

