def algorithm_2_exact(A, B, w, lambda_param, tau, sigma, T, C_init, Lambda_init):
    """
    EXACT Algorithm 2: primal-dual-wSRLASSO-C
    Following the pseudocode line by line for K=1 (scalar case)
    """
    m, N = A.shape
    
    # Step: initialize C_bar^(0) = 0
    C_bar = np.zeros(N)
    C = np.copy(C_init)
    Lambda = np.copy(Lambda_init)
    
    error_history_iter = []
    error_history_ergodic = []
    
    # Main loop: for n = 0, 1, ..., T-1
    for n in range(T):
        # Step 2: P = C^(n) - tau * A^T * Lambda^(n)
        P = C - tau * A.T @ Lambda
        
        # Step 3-6: Weighted soft thresholding
        C_next = np.zeros(N)
        for i in range(N):
            if np.abs(P[i]) > tau * lambda_param * w[i]:
                C_next[i] = np.sign(P[i]) * (np.abs(P[i]) - tau * lambda_param * w[i])
            else:
                C_next[i] = 0.0
        
        # Step 8: Q = Lambda^(n) + sigma * A * (2*C^(n+1) - C^(n)) - sigma * B
        Q = Lambda + sigma * A @ (2 * C_next - C) - sigma * B
        
        # Step 9: Projection onto unit ball
        norm_Q = np.linalg.norm(Q)
        if norm_Q > 1.0:
            Lambda_next = Q / norm_Q
        else:
            Lambda_next = Q
        
        # Step 10: Update ergodic sequence
        C_bar = (n / (n + 1)) * C_bar + (1 / (n + 1)) * C_next
        
        # Update for next iteration
        C = C_next
        Lambda = Lambda_next
        
        # Store coefficients for error calculation
        error_history_iter.append(np.copy(C_next))
        error_history_ergodic.append(np.copy(C_bar))
    
    return C_bar, error_history_iter, error_history_ergodic

# =============================================================================
# EXACT Algorithm 5 Implementation (from pseudocode)
# =============================================================================

def algorithm_5_exact(A, B, w, lambda_param, T, R, eps_0, r, s, Psi_eval, y_true, w_pos):
    """
    EXACT Algorithm 5: primal-dual-rst-wSRLASSO-C
    Following the pseudocode exactly line by line
    BUT tracking error at EVERY inner iteration for smooth curves
    """
    m, N = A.shape
    
    # Step: initialize C_tilde^(0) = 0, eps_0 = ||B||_2
    C_tilde = np.zeros(N)
    eps_0_init = np.linalg.norm(B)  # ε₀ = ||b||₂ from Algorithm 5
    
    # Track convergence AT EVERY ITERATION (not just restart boundaries)
    denom_sq = np.dot(y_true**2, w_pos)
    iter_counts = [0]
    error_history = [1.0]  # Initial error
    total_iterations = 0
    
    eps_l = eps_0_init
    
    # Main restart loop: for l = 0, ..., R-1
    for l in range(R):
        # Step 2: eps_{l+1} = r * (eps_l + eps_0)
        eps_l = r * (eps_l + eps_0)
        
        # Step 3: a_l = s * eps_{l+1}
        a_l = s * eps_l
        
        # Step 4: Call Algorithm 2 with scaled inputs
        if a_l > 1e-15:  # Avoid numerical issues
            # Prepare scaled inputs exactly as in Algorithm 5
            C_init_scaled = C_tilde / a_l if np.linalg.norm(C_tilde) > 0 else np.zeros(N)
            Lambda_init_scaled = np.zeros(m)
            B_scaled = B / a_l
            
            # Use step sizes from Table 5.1: τ = σ = ||A||₂⁻¹
            norm_A = np.linalg.norm(A, ord=2)
            tau = 1.0 / norm_A
            sigma = 1.0 / norm_A
            
            # Call Algorithm 2 and get INNER iteration history
            C_result, inner_iter_hist, inner_ergodic_hist = algorithm_2_exact(
                A, B_scaled, w, lambda_param, tau, sigma, T, 
                C_init_scaled, Lambda_init_scaled
            )
            
            # KEY CHANGE: Track error at EVERY inner iteration
            for t in range(T):
                total_iterations += 1
                
                # Get current coefficient vector from inner iteration
                C_inner_current = inner_ergodic_hist[t]  # Use ergodic sequence
                
                # Rescale back to original problem
                C_tilde_current = a_l * C_inner_current
                
                # Calculate error at this iteration
                if denom_sq > 0:
                    y_pred = Psi_eval @ C_tilde_current
                    num_sq = np.dot((y_true - y_pred)**2, w_pos)
                    current_error = np.sqrt(num_sq / denom_sq)
                    error_history.append(current_error)
                    iter_counts.append(total_iterations)
                else:
                    error_history.append(np.nan)
                    iter_counts.append(total_iterations)
                
                # Early stopping if we've reached 1000 iterations
                if total_iterations >= 1000:
                    break
            
            # Update C_tilde to final result of this restart
            C_tilde = a_l * C_result
        else:
            # If a_l is too small, just advance iterations without computing
            total_iterations += T
        
        # Break conditions
        if total_iterations >= 1000:
            break
    
    return C_tilde, iter_counts, error_history

