# Compute L(m,d,ε₀) via Eq. (3.8): L = √(2/m)·d·ln(3d/ε₀)
def compute_L(m, d, eps0):
    return np.sqrt(2.0/m) * d * np.log(3.0 * d / eps0)

L_val = compute_L(m, d, eps0)
print(f"L(m,d,ε₀) computation:")
