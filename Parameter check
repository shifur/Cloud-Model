# Generate multi-index set (simplified version of your multiidx_gen)
def multiidx_gen(N, rule, w, base=0, idx=np.array([]), M=np.array([])):
    if len(idx) != N:
        i = base
        while rule(np.append(idx, i)) <= w:
            M = multiidx_gen(N, rule, w, base, np.append(idx, i), M)
            i += 1
    else:
        M = np.vstack([M, idx]) if M.size else idx
    return M

Lambda = multiidx_gen(d, HCfunc, p_poly).astype(int)
