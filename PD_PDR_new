import numpy as np
import matplotlib.pyplot as plt
from scipy.special import legendre
import sys
import time

sys.path.append('/home/ss24ce/.local/lib/python3.10/site-packages')

import Tasmanian
from parmap_framework import parmap
from module_runcrm import runcrm

# =============================================================================
# OPTIMIZED ALGORITHMS 2 & 5 
# =============================================================================

def primal_dual_weighted_sr_lasso(A, b, w, lambda_param, tau, sigma, T, x_init=None, y_init=None):
    """
    Algorithm 2: Weighted SR-LASSO via Chambolle–Pock
    """
    m, N = A.shape
    x = np.copy(x_init) if x_init is not None else np.zeros(N)
    y = np.copy(y_init) if y_init is not None else np.zeros(m)

    for n in range(T):
        # Primal update: p = x - τ A^T y
        p = x - tau * (A.T @ y)
        # Soft‐threshold: x₊ = sign(p) * max(|p| − τλw, 0)
        x_new = np.sign(p) * np.maximum(np.abs(p) - tau * lambda_param * w, 0)
        # Dual update: q = y + σ A (2x₊ − x) − σ b
        q = y + sigma * A @ (2 * x_new - x) - sigma * b
        norm_q = np.linalg.norm(q)
        # Projection onto ℓ₂‐ball: y₊ = q / max(1, ‖q‖)
        y = q / norm_q if norm_q > 1.0 else q
        x = x_new

    return x

def restarted_primal_dual_weighted_sr_lasso(A, b, w, lambda_param,
                                           T, R, eps_0, r, s, tau, sigma):
    """
    Algorithm 5: Restarted Primal–Dual for Weighted SR-LASSO (Scalar K=1)
    """
    m, N = A.shape
    x_tilde = np.zeros(N)
    eps_l = np.linalg.norm(b)  # initial error ‖b‖₂

    for _ in range(R):
        # 1) update tolerance: ε_{l+1} = r (ε_l + ε₀)
        eps_l = r * (eps_l + eps_0)
        # 2) compute scaling a_l = s ε_{l+1}
        a_l = s * eps_l
        # 3) scale data & init
        x0 = x_tilde / a_l if np.linalg.norm(x_tilde) > 0 else np.zeros(N)
        y0 = np.zeros(m)
        b0 = b / a_l
        # 4) inner solver (Algorithm 2) for T steps
        x_res = primal_dual_weighted_sr_lasso(A, b0, w,
                                              lambda_param, tau, sigma, T,
                                              x_init=x0, y_init=y0)
        # 5) un-scale
        x_tilde = a_l * x_res

    return x_tilde

# =============================================================================
# ATMOSPHERIC MODELING CODE - SETUP
# =============================================================================

np.random.seed(42)
d, K = 11, 6

# Parameter bounds
pmin = np.array([50.0,0.10,50.0,0.1,0.05,0.05,0.05,0.05,0.05,1e-4,2e-6])
pmax = np.array([1000.0,1.0,1200.0,0.90,5.0,2.5,2.5,1.0,1.0,2e-3,1e-3])
volume_phys = np.prod(pmax - pmin)

def map_to_canonical(X):
    return 2*(X - pmin)/(pmax - pmin) - 1

# Multi-index generation (hyperbolic cross)
HCfunc  = lambda x: np.prod(x+1) - 1
p_poly  = 20
def multiidx_gen(N, rule, w, base=0, idx=None, out=None):
    if idx is None: idx = np.array([])
    if out is None: out = np.empty((0,N), int)
    if len(idx) < N:
        i = base
        while rule(np.append(idx,i)) <= w:
            out = multiidx_gen(N, rule, w, base, np.append(idx,i), out)
            i += 1
    else:
        out = np.vstack([out, idx])
    return out

Lambda    = multiidx_gen(d, HCfunc, p_poly)
N_basis   = Lambda.shape[0]

# Intrinsic Legendre weights u_ν = ∏√(2ν_j+1)
weights = np.ones(N_basis)
for n in range(N_basis):
    for j in range(d):
        weights[n] *= np.sqrt(2*Lambda[n,j] + 1)

# =====================================================================
# 3. Sparse-grid reference solution
# =====================================================================
grid = Tasmanian.SparseGrid()
grid.makeGlobalGrid(d, 0, 4, "level", "clenshaw-curtis")
grid.clearDomainTransform()
xi_can = grid.getPoints()
w_can  = grid.getQuadratureWeights()
m_sg   = xi_can.shape[0]

# Evaluate CRM model on sparse-grid
x_phys_sg = 0.5*(xi_can+1)*(pmax-pmin) + pmin
runs_sg   = [[ './cloud_column_model/run_one_crm1d.txt',
               './cloud_column_model/crm1d_output.txt',
               './cloud_column_model/namelist_3h_t30-180.f90',
               i+1, x_phys_sg[i].tolist() ] for i in range(m_sg)]
print("Running CRM for SG projection...")
pmap      = parmap.Parmap(master='scispark6.jpl.nasa.gov:8786',
                           mode='par', numWorkers=12)
F_sg_full = np.array(pmap(runcrm, runs_sg))
F_sg      = F_sg_full[:,18:24]

# Build Psi_sg
Psi_sg = np.ones((m_sg, N_basis))
for n in range(N_basis):
    for j in range(d):
        Pj     = legendre(Lambda[n,j])
        norm_j = np.sqrt((2*Lambda[n,j]+1)/2)
        Psi_sg[:,n] *= norm_j * Pj(xi_can[:,j])

# Physical weights for L2 error
w_phys = w_can * (volume_phys / (2**d))
w_pos  = np.abs(w_phys)

# =====================================================================
# 4. Training data preparation
# =====================================================================
m_train = 1000
x_train = np.random.uniform(pmin, pmax, (m_train,d))
i_train = map_to_canonical(x_train)
runs_tr = [[ './cloud_column_model/run_one_crm1d.txt',
             './cloud_column_model/crm1d_output.txt',
             './cloud_column_model/namelist_3h_t30-180.f90',
             i+1, x_train[i].tolist() ] for i in range(m_train)]
print("Running CRM for SR-LASSO training...")
F_tr_full = np.array(pmap(runcrm, runs_tr))
F_train   = F_tr_full[:,18:24]

# Build A, b
Psi_tr = np.ones((m_train, N_basis))
for n in range(N_basis):
    for j in range(d):
        Pj     = legendre(Lambda[n,j])
        norm_j = np.sqrt((2*Lambda[n,j]+1)/2)
        Psi_tr[:,n] *= norm_j * Pj(i_train[:,j])
A = Psi_tr / np.sqrt(m_train)
b = F_train / np.sqrt(m_train)

# =============================================================================
# FORMULA-BASED PARAMETER CALCULATION (Table 4.3)
# =============================================================================
m, N = A.shape

# ‖A‖₂ = spectral norm of A
norm_A = np.linalg.norm(A, 2)
# Lipschitz constant L = ‖A‖₂²
L = norm_A**2
# initial error ‖b‖₂
initial_err = np.linalg.norm(b)
# total PD iterations budget
total_iters = 1000
# exponent α from (3.7) for Legendre
alpha = 1.0  

# restart tolerance ζ = ε₀ = N_basis^α  (Table 4.3)
eps_0 = N_basis**alpha

# shrink factor r = e^{−1}  (Table 4.3)
r = np.exp(-1)

# number of restarts R = ceil( log(initial_err/ε₀) / (−log r) )
R_restart = int(np.ceil(np.log(initial_err/eps_0)/(-np.log(r))))

# inner steps per restart T = floor(total_iters / R)
T_restart = total_iters // R_restart
if T_restart < 1:
    raise ValueError("total_iters too small for computed R_restart")

# primal/dual step‐sizes (slightly below 1/‖A‖₂ for stability)
tau   = 0.99 / norm_A
sigma = tau

# penalty λ = 1 / (4 √(m / L))  (eqn (3.8), Table 4.3)
lambda_param = 1.0/(4.0*np.sqrt(m/L))

# scaling constant s = τ·T / 2  (Table 4.3)
s = tau * T_restart / 2.0

print(f"Parameters:\n"
      f" total_iters={total_iters}, R={R_restart}, T={T_restart}\n"
      f" eps_0={eps_0}, r={r:.4f}, s={s:.4f}\n"
      f" τ={tau:.4g}, σ={sigma:.4g}, λ={lambda_param:.4g}")

# =============================================================================
# SINGLE SOLVE DEMO
# =============================================================================
xhat_pd  = np.zeros((N_basis, K))
xhat_pdr = np.zeros((N_basis, K))
start = time.time()
for k in range(K):
    xhat_pd[:,k]  = primal_dual_weighted_sr_lasso(
        A, b[:,k], weights, lambda_param, tau, sigma, T_restart*R_restart)
    xhat_pdr[:,k] = restarted_primal_dual_weighted_sr_lasso(
        A, b[:,k], weights, lambda_param,
        T_restart, R_restart, eps_0, r, s, tau, sigma)
print(f"Single solve done in {time.time()-start:.2f}s")

# =============================================================================
# LEARNING CURVE ANALYSIS
# =============================================================================
train_sizes = np.arange(100, 2001, 100)
results = {'pd': [], 'pdr': []}

for m_tr in train_sizes:
    Xi_sub = i_train[:m_tr]
    F_sub  = F_train[:m_tr]
    # rebuild A_sub, b_sub
    Psi_sub = np.ones((m_tr, N_basis))
    for n in range(N_basis):
        for j in range(d):
            Pj     = legendre(Lambda[n,j])
            norm_j = np.sqrt((2*Lambda[n,j]+1)/2)
            Psi_sub[:,n] *= norm_j * Pj(Xi_sub[:,j])
    A_sub = Psi_sub / np.sqrt(m_tr)
    b_sub = F_sub / np.sqrt(m_tr)

    # recompute params
    norm_A_sub = np.linalg.norm(A_sub, 2)
    err_sub    = np.linalg.norm(b_sub)
    R_sub      = int(np.ceil(np.log(err_sub/eps_0)/(-np.log(r))))
    T_sub      = total_iters // R_sub
    if T_sub < 1:
        raise ValueError("total_iters too small for computed R_sub")
    tau_sub   = 0.99 / norm_A_sub
    sigma_sub = tau_sub
    s_sub     = tau_sub * T_sub / 2.0

    # solve
    x_pd  = np.zeros((N_basis, K))
    x_pdr = np.zeros((N_basis, K))
    for k in range(K):
        x_pd[:,k]  = primal_dual_weighted_sr_lasso(
            A_sub, b_sub[:,k], weights, lambda_param, tau_sub, sigma_sub, T_sub*R_sub)
        x_pdr[:,k] = restarted_primal_dual_weighted_sr_lasso(
            A_sub, b_sub[:,k], weights, lambda_param,
            T_sub, R_sub, eps_0, r, s_sub, tau_sub, sigma_sub)

    # evaluate L2 errors
    y_true = F_sg
    y_pd   = Psi_sg @ x_pd
    y_pdr  = Psi_sg @ x_pdr
    l2_pd, l2_pdr = [], []
    for k in range(K):
        num_pd  = np.dot((y_true[:,k]-y_pd[:,k])**2,   w_pos)
        num_pdr = np.dot((y_true[:,k]-y_pdr[:,k])**2, w_pos)
        den     = np.dot((y_true[:,k])**2,             w_pos)
        l2_pd.append(np.sqrt(num_pd/den))
        l2_pdr.append(np.sqrt(num_pdr/den))

    results['pd'].append(l2_pd)
    results['pdr'].append(l2_pdr)

# plot average learning curve
pd_err  = np.mean(np.array(results['pd']),  axis=1)
pdr_err = np.mean(np.array(results['pdr']), axis=1)
plt.figure(figsize=(8,5))
plt.loglog(train_sizes, pd_err,  'o-', label='PD (avg)')
plt.loglog(train_sizes, pdr_err, 's-', label='PDR (avg)')
plt.xlabel('Training Sample Size')
plt.ylabel('Average L2 Relative Error')
plt.title('11D Learning Curve: PD vs PDR')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()
