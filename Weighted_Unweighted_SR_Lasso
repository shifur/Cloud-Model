    # Plot learning curves
    ax.loglog(train_sizes, l2_errors_weighted_array[:, k], 'o-', 
             label='Weighted SR-LASSO', color='blue', linewidth=2, markersize=6)
    ax.loglog(train_sizes, l2_errors_unweighted_array[:, k], 's-', 
