# Add theoretical decay line
theoretical_decay = 0.1 * (np.array(train_sizes) / train_sizes[0])**(-0.5)
ax.loglog(train_sizes, theoretical_decay, '--', color='gray', alpha=0.7, 
         label='m^(-1/2) reference', linewidth=2)

ax.set_xlabel('Training Sample Size', fontsize=14)
