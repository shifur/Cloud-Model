avg_l2_unweighted = np.mean(l2_errors_unweighted_array, axis=1)

ax.loglog(train_sizes, avg_l2_weighted, 'o-', 
         label='Weighted SR-LASSO (Average)', color='blue', linewidth=3, markersize=8)
