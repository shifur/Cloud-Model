    ax.legend()
    ax.grid(True, alpha=0.3)
    
    # Add theoretical decay line for reference
    theoretical_decay = 0.1 * (np.array(train_sizes) / train_sizes[0])**(-0.5)
    ax.loglog(train_sizes, theoretical_decay, '--', color='gray', alpha=0.7, label='m^(-1/2) reference')

plt.tight_layout()
plt.show()

# Plot average learning curve
fig, ax = plt.subplots(1, 1, figsize=(10, 6))

