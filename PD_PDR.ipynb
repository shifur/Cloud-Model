    # --- (2) SORTED Unweighted Coefficient Decay ---
    axs[0,1].scatter(inds, np.sort(np.abs(xhat_SG))[::-1], marker='o', label='Sorted SG', alpha=0.7, color='red', s=20)
    axs[0,1].scatter(inds, np.sort(np.abs(xhat_PD))[::-1], marker='+', label='Sorted PD', alpha=0.7, color='blue', s=30)
    axs[0,1].scatter(inds, np.sort(np.abs(xhat_PDR))[::-1], marker='x', label='Sorted PDR', alpha=0.7, color='green', s=30)
    axs[0,1].set_yscale('log')
    axs[0,1].set_xlabel('Sorted Index')
    axs[0,1].set_ylabel('|Coefficient|')
    axs[0,1].set_title(f'Sorted Unweighted Coefficient Decay: {output_names[k]} (11D: All Parameters)')
    axs[0,1].legend()
    axs[0,1].grid(True, alpha=0.3)
    
    # --- (3) WEIGHTED Coefficient Comparison ---
    axs[1,0].plot(inds, weighted_xhat_SG, 'o', label='Weighted SG', alpha=0.7, color='red', markersize=4)
