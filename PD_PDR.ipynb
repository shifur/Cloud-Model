# =============================================================================
# OPTIMIZED ALGORITHMS 2 & 5 - Matrix-Based Step Sizes Only
# =============================================================================

def primal_dual_weighted_sr_lasso(A, b, w, lambda_param, tau, sigma, T, x_init=None, y_init=None):
    """
    Algorithm 2 Modified for Scalar-Valued Weighted SR-LASSO (K=1)
    - Matrix-based step sizes
    - Identity Gram matrix (G = I)
    - Weighted structure only
    """
    m, N = A.shape
    
    # Initialize variables
    if x_init is None:
        x = np.zeros(N)
    else:
        x = np.copy(x_init)
    
    if y_init is None:
        y = np.zeros(m)
    else:
        y = np.copy(y_init)
    
    x_bar = np.zeros(N)  # Ergodic sequence
    
    # Main primal-dual iterations (Algorithm 2 from book)
    for n in range(T):
        # Step 2: P = C^(n) - τ * A^T * Λ^(n)
        p = x - tau * A.T @ y
        
        # Steps 3-6: Weighted soft thresholding for scalar case
        # Since G = I (identity), ||G^(1/2) * p_i||_2 = |p_i|
        x_new = np.zeros(N)
        for i in range(N):
            threshold = tau * lambda_param * w[i]
            if np.abs(p[i]) > threshold:
                x_new[i] = np.sign(p[i]) * (np.abs(p[i]) - threshold)
            else:
                x_new[i] = 0.0
        
        # Step 8: Q = Λ^(n) + σ * A * (2*C^(n+1) - C^(n)) - σ * B
        q = y + sigma * A @ (2 * x_new - x) - sigma * b
        
        # Step 9: Projection onto unit ball
        # Since G = I, ||Q * G^(1/2)||_{2,2} = ||Q||_2
        norm_q = np.linalg.norm(q)
        if norm_q > 1.0:
            y_new = q / norm_q
        else:
            y_new = q
        
        # Step 10: Update ergodic sequence
        x_bar = (n / (n + 1)) * x_bar + (1 / (n + 1)) * x_new
        
        # Update for next iteration
        x = x_new
        y = y_new
    
    return x

def restarted_primal_dual_weighted_sr_lasso(A, b, w, lambda_param, T, R, eps_0, r, s, tau, sigma):
    """
    Algorithm 5 Modified for Scalar-Valued Weighted SR-LASSO (K=1)
    - Matrix-based step sizes
    - Restarted version for exponential convergence
    """
    m, N = A.shape
    
    # Initialize (Algorithm 5)
    x_tilde = np.zeros(N)
    eps_l = np.linalg.norm(b)  # ε₀ = ||B||_2 from Algorithm 5
    
    # Main restart loop
    for l in range(R):
        # Step 2: ε_{l+1} = r * (ε_l + ε₀)
        eps_l = r * (eps_l + eps_0)
        
        # Step 3: a_l = s * ε_{l+1}
        a_l = s * eps_l
        
        # Step 4: Call Algorithm 2 with scaled inputs
        if a_l > 1e-15:  # Avoid numerical issues
            # Scale inputs as per Algorithm 5
            x_init_scaled = x_tilde / a_l if np.linalg.norm(x_tilde) > 0 else np.zeros(N)
            y_init_scaled = np.zeros(m)
            b_scaled = b / a_l
            
            # Call basic primal-dual algorithm with matrix step sizes
            x_result = primal_dual_weighted_sr_lasso(
                A, b_scaled, w, lambda_param, tau, sigma, T, 
                x_init_scaled, y_init_scaled
            )
            
            # Scale back to original problem
            x_tilde = a_l * x_result
    
    return x_tilde

