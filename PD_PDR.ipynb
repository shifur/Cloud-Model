    axs[0,0].plot(inds, np.abs(xhat_PD), '+', label='PD (Matrix)', alpha=0.7, color='blue', markersize=6)
    axs[0,0].plot(inds, np.abs(xhat_PDR), 'x', label='PDR (Matrix)', alpha=0.7, color='green', markersize=6)
