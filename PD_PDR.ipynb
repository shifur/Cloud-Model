# 1. Setup - Modified for 11D (ALL parameters)
np.random.seed(42)
d = 11  # All 11 parameters
K = 6   # 6 output variables

# Parameter bounds for 11D space: all parameters
# Parameters: as, bs, ag, bg, N0r, N0s, N0g, rhos, rhog, qc0, qi0
pmin = np.array([50.0, 0.10, 50.0, 0.1, 0.05, 0.05, 0.05, 0.05, 0.05, 1.e-4, 2.e-6])
pmax = np.array([1000.0, 1.0, 1200.0, 0.90, 5.0, 2.5, 2.5, 1.0, 1.0, 2.e-3, 1.e-3])
xnames = ['as', 'bs', 'ag', 'bg', 'N0r', 'N0s', 'N0g', 'rhos', 'rhog', 'qc0', 'qi0']

volume_phys = np.prod(pmax - pmin)

print(f"11D Parameter Analysis Setup:")
print(f"Varying parameters ({d}D - ALL parameters):")
for i, name in enumerate(xnames):
    print(f"  {name}: [{pmin[i]:.2e}, {pmax[i]:.2e}]")

def map_to_canonical(X):
    return 2 * (X - pmin) / (pmax - pmin) - 1

# 2. Multi-index generation
HCfunc = lambda x: np.prod(x + 1) - 1
p_poly = 20  # Reduced for 11D computational feasibility

def multiidx_gen(N, rule, w, base=0, multiidx=np.array([]), MULTI_IDX=np.array([])):
    if len(multiidx) != N:
        i = base
        while rule(np.append(multiidx, i)) <= w:
            MULTI_IDX = multiidx_gen(N, rule, w, base, np.append(multiidx, i), MULTI_IDX)
            i += 1
    else:
        MULTI_IDX = np.vstack([MULTI_IDX, multiidx]) if MULTI_IDX.size else multiidx
    return MULTI_IDX

Lambda = multiidx_gen(d, HCfunc, p_poly).astype(int)
N_basis = Lambda.shape[0]
print(f"11D basis size: {N_basis}")

# Compute intrinsic weights for Legendre polynomials (Book's formula 4.7)
def compute_intrinsic_weights_legendre(Lambda):
    """
    Compute intrinsic weights for Legendre polynomials
    Book's formula: u_ν = ∏_{j=1}^d √(2ν_j + 1)
    """
    N_basis = Lambda.shape[0]
    weights = np.ones(N_basis)
    
    for n in range(N_basis):
        for k in range(Lambda.shape[1]):
            # Intrinsic weight for Legendre: sqrt(2*nu_k + 1)
            weights[n] *= np.sqrt(2 * Lambda[n, k] + 1)
    
    return weights

# Generate intrinsic weights
weights = compute_intrinsic_weights_legendre(Lambda)
print(f"Intrinsic weights computed - Range: [{np.min(weights):.3f}, {np.max(weights):.3f}]")

# Weight analysis
print(f"\nWeight Analysis:")
print(f"- Number of basis functions: {N_basis}")
print(f"- Min weight: {np.min(weights):.6f}")
print(f"- Max weight: {np.max(weights):.6f}")
print(f"- Weight ratio (max/min): {np.max(weights)/np.min(weights):.2f}")

# 3. Tasmanian Sparse Grid setup
grid = Tasmanian.SparseGrid()
grid.makeGlobalGrid(d, 0, 3, "level", "clenshaw-curtis")  # 11D grid (reduced level for computational feasibility)
grid.clearDomainTransform()

xi_can = grid.getPoints()
w_can = grid.getQuadratureWeights()
m_sg = xi_can.shape[0]
print(f"SG grid size: {m_sg}")

# 4. Evaluate Cloud Model
x_phys_sg = 0.5 * (xi_can + 1) * (pmax - pmin) + pmin

input_file = './cloud_column_model/run_one_crm1d.txt'
output_file = './cloud_column_model/crm1d_output.txt'
namelist_file = './cloud_column_model/namelist_3h_t30-180.f90'

runs_sg = [[input_file, output_file, namelist_file, i+1, x_phys_sg[i].tolist()] for i in range(m_sg)]
print("Running CRM for SG projection...")
pmap = parmap.Parmap(master='scispark6.jpl.nasa.gov:8786', mode='par', numWorkers=12)
F_sg_full = np.array(pmap(runcrm, runs_sg))
F_sg = F_sg_full[:, 18:24]

# 5. Build Psi_sg for 11D tensor product
Psi_sg = np.ones((m_sg, N_basis))
for n in range(N_basis):
    for k in range(d):  # k=0 to 10 for all 11 parameters
        Pk = legendre(Lambda[n, k])
        norm = np.sqrt((2 * Lambda[n, k] + 1) / 2)
        Psi_sg[:, n] *= norm * Pk(xi_can[:, k])

# 6. SG Gram Matrix and Coefficients
G_sg = Psi_sg.T @ (w_can[:, None] * Psi_sg)
coeff_sg = Psi_sg.T @ (w_can[:, None] * F_sg)

diag_err = np.max(np.abs(np.diag(G_sg) - 1.0))
offdiag_err = np.max(np.abs(G_sg - np.diag(np.diag(G_sg))))
print(f"SG Gram matrix - Diagonal error: {diag_err:.2e}, Off-diagonal error: {offdiag_err:.2e}")

# 7. SR-LASSO Training Samples (Fixed size demo)
m_train = 1000
x_train = np.random.uniform(pmin, pmax, size=(m_train, d))
xi_train = map_to_canonical(x_train)

runs_train = [[input_file, output_file, namelist_file, i+1, x_train[i].tolist()] for i in range(m_train)]
print("Running CRM for SR-LASSO training...")
F_train_full = np.array(pmap(runcrm, runs_train))
F_train = F_train_full[:, 18:24]

# 8. Build A matrix for 11D
A = np.ones((m_train, N_basis))
for n in range(N_basis):
    for k in range(d):
        Pk = legendre(Lambda[n, k])
        norm = np.sqrt((2 * Lambda[n, k] + 1) / 2)
        A[:, n] *= norm * Pk(xi_train[:, k])

A /= np.sqrt(m_train)
b = F_train / np.sqrt(m_train)

# =============================================================================
# OPTIMIZED WEIGHTED SR-LASSO SOLVER - Matrix Step Sizes Only (Demo)
# =============================================================================
print("\n=== WEIGHTED SR-LASSO WITH OPTIMIZED PRIMAL-DUAL ALGORITHMS (Demo) ===")
print("Using Matrix-Based Step Sizes for Optimal Performance")

# Basic parameters
lambda_param = 1e-5  # Regularization parameter

# Matrix-Based Step Sizes (Optimal)
norm_A = np.linalg.norm(A, ord=2)
tau = 0.99 / norm_A  # Slightly less than 1/||A||₂ for stability
sigma = 0.99 / norm_A

print(f"Optimized Parameters:")
print(f"- λ: {lambda_param:.6f}")
print(f"- ||A||₂: {norm_A:.6f}")
print(f"- τ = σ: {tau:.6f}")

# Iteration counts - Optimized for best performance
T_basic = 500   # Iterations for basic PD
T_restart = 50  # Iterations per restart
R_restart = 10  # Number of restarts

# Restart parameters
r = np.exp(-1)  # r = e^(-1)
s = tau * T_restart / 2
eps_0 = 1e-6

print(f"- Basic PD iterations: {T_basic}")
print(f"- Restart PDR: {T_restart} × {R_restart} = {T_restart * R_restart} total iterations")

# Solve weighted SR-LASSO for each output using optimized algorithms
xhat_pd = np.zeros((N_basis, K))    # PD with matrix step sizes
xhat_pdr = np.zeros((N_basis, K))   # PDR with matrix step sizes

print("\nSolving Weighted SR-LASSO with optimized algorithms...")
start_time = time.time()

output_names = ['PCP', 'ACC', 'LWP', 'IWP', 'OLR', 'OSR']

for k in range(K):
    print(f"  Solving for {output_names[k]} ({k+1}/{K})")
    
    # Basic PD with matrix step sizes
    xhat_pd[:, k] = primal_dual_weighted_sr_lasso(
        A, b[:, k], weights, lambda_param, tau, sigma, T_basic
    )
    
    # Restart PDR with matrix step sizes
    xhat_pdr[:, k] = restarted_primal_dual_weighted_sr_lasso(
        A, b[:, k], weights, lambda_param, T_restart, R_restart, eps_0, r, s, tau, sigma
    )

end_time = time.time()
print(f"✔️ All Weighted SR-LASSO problems solved in {end_time - start_time:.2f} seconds")

# Sparsity analysis
print(f"\nSparsity Analysis:")
for k in range(K):
    nz_sg = np.count_nonzero(np.abs(coeff_sg[:, k]) > 1e-12)
    nz_pd = np.count_nonzero(np.abs(xhat_pd[:, k]) > 1e-12)
    nz_pdr = np.count_nonzero(np.abs(xhat_pdr[:, k]) > 1e-12)
    
    print(f"- {output_names[k]}:")
    print(f"  SG:        {nz_sg}/{N_basis} ({100*nz_sg/N_basis:.1f}%)")
    print(f"  PD:        {nz_pd}/{N_basis} ({100*nz_pd/N_basis:.1f}%)")
    print(f"  PDR:       {nz_pdr}/{N_basis} ({100*nz_pdr/N_basis:.1f}%)")

# =============================================================================
# L2 Relative Error Computation (Demo)
# =============================================================================
volume_phys_11d = np.prod(pmax - pmin)
w_phys = w_can * (volume_phys_11d / (2**d))  # 11D: divide by 2^11
w_pos = np.abs(w_phys)

# Build evaluation matrix
Psi_SG = np.ones((m_sg, N_basis))
for n in range(N_basis):
    for k in range(d):
        Pk = legendre(Lambda[n, k])
        norm = np.sqrt((2 * Lambda[n, k] + 1) / 2)
        Psi_SG[:, n] *= norm * Pk(xi_can[:, k])

# Evaluate all methods
y_SG_true = F_sg  # True SG values
y_SG_pd = Psi_SG @ xhat_pd
y_SG_pdr = Psi_SG @ xhat_pdr

# Compute L2 relative errors
l2_error_pd = np.zeros(K)
l2_error_pdr = np.zeros(K)

for k in range(K):
    denom_sq = np.dot(y_SG_true[:, k]**2, w_pos)
    
    if denom_sq > 0:
        # PD error
        diff = y_SG_true[:, k] - y_SG_pd[:, k]
        l2_error_pd[k] = np.sqrt(np.dot(diff**2, w_pos) / denom_sq)
        
        # PDR error
        diff = y_SG_true[:, k] - y_SG_pdr[:, k]
        l2_error_pdr[k] = np.sqrt(np.dot(diff**2, w_pos) / denom_sq)

print(f"\nL2 Relative Test Errors (Demo - {m_train} samples):")
print(f"PD:  {l2_error_pd}")
print(f"PDR: {l2_error_pdr}")

# =============================================================================
# LEARNING CURVE ANALYSIS WITH PD/PDR ALGORITHMS
# =============================================================================

print(f"\n{'='*80}")
print("STARTING 11D LEARNING CURVE ANALYSIS")
print(f"{'='*80}")

# Training sample sizes to test
train_sizes = list(range(50, 2001, 50))  # 50, 100, 150, ..., 1000
print(f"Training sizes to test: {train_sizes}")

# Storage for learning curve results
learning_curve_results = {
    'train_sizes': train_sizes,
    'l2_errors_pd': [],
    'l2_errors_pdr': [],
    'sparsity_pd': [],
    'sparsity_pdr': [],
    'solve_times_pd': [],
    'solve_times_pdr': []
}

# Generate maximum training set once
m_train_max = max(train_sizes)
x_train_max = np.random.uniform(pmin, pmax, size=(m_train_max, d))
xi_train_max = map_to_canonical(x_train_max)

print(f"Generating {m_train_max} training samples for learning curve...")
runs_train_max = [[input_file, output_file, namelist_file, i+1, x_train_max[i].tolist()] for i in range(m_train_max)]
F_train_max_full = np.array(pmap(runcrm, runs_train_max))
F_train_max = F_train_max_full[:, 18:24]

# Learning curve loop
for train_size in train_sizes:
    print(f"\n{'='*60}")
    print(f"Learning Curve: Training with {train_size} samples")
    print(f"{'='*60}")
    
    # Use subset of training data
    x_train_subset = x_train_max[:train_size]
    xi_train_subset = xi_train_max[:train_size]
    F_train_subset = F_train_max[:train_size]
    
    # Build A matrix for current training size
    A_subset = np.ones((train_size, N_basis))
    for n in range(N_basis):
        for k in range(d):
            Pk = legendre(Lambda[n, k])
            norm = np.sqrt((2 * Lambda[n, k] + 1) / 2)
            A_subset[:, n] *= norm * Pk(xi_train_subset[:, k])

    A_subset /= np.sqrt(train_size)
    b_subset = F_train_subset / np.sqrt(train_size)

    # Algorithm parameters (same as demo)
    lambda_param = 1e-5
    norm_A_subset = np.linalg.norm(A_subset, ord=2)
    tau_subset = 0.99 / norm_A_subset
    sigma_subset = 0.99 / norm_A_subset
    
    # Iteration counts (same as demo)
    T_basic = 500
    T_restart = 50
    R_restart = 10
    r = np.exp(-1)
    s = tau_subset * T_restart / 2
    eps_0 = 1e-6
    
    print(f"Algorithm parameters:")
    print(f"  λ = {lambda_param:.6f}, ||A||₂ = {norm_A_subset:.6f}")
    print(f"  PD: T = {T_basic}, PDR: T = {T_restart}, R = {R_restart}")
    
    # Initialize coefficient arrays
    xhat_pd_curve = np.zeros((N_basis, K))
    xhat_pdr_curve = np.zeros((N_basis, K))
    
    # Solve for each output using both PD and PDR
    start_time_pd = time.time()
    for k in range(K):
        xhat_pd_curve[:, k] = primal_dual_weighted_sr_lasso(
            A_subset, b_subset[:, k], weights, lambda_param, tau_subset, sigma_subset, T_basic
        )
    end_time_pd = time.time()
    solve_time_pd = end_time_pd - start_time_pd
    
    start_time_pdr = time.time()
    for k in range(K):
        xhat_pdr_curve[:, k] = restarted_primal_dual_weighted_sr_lasso(
            A_subset, b_subset[:, k], weights, lambda_param, T_restart, R_restart, eps_0, r, s, tau_subset, sigma_subset
        )
    end_time_pdr = time.time()
    solve_time_pdr = end_time_pdr - start_time_pdr
    
    print(f"✔️ PD solved in {solve_time_pd:.2f} seconds")
    print(f"✔️ PDR solved in {solve_time_pdr:.2f} seconds")
    
    # Evaluate surrogates on SG points
    y_SG_eval_pd = Psi_SG @ xhat_pd_curve
    y_SG_eval_pdr = Psi_SG @ xhat_pdr_curve
    y_true_SG = F_sg
    
    # Compute L2 relative errors
    l2_rel_error_pd = np.zeros(K)
    l2_rel_error_pdr = np.zeros(K)
    
    for k in range(K):
        denom_sq = np.dot(y_true_SG[:, k]**2, w_pos)
        if denom_sq > 0:
            # PD errors
            diff_pd = y_true_SG[:, k] - y_SG_eval_pd[:, k]
            l2_rel_error_pd[k] = np.sqrt(np.dot(diff_pd**2, w_pos) / denom_sq)
            
            # PDR errors
            diff_pdr = y_true_SG[:, k] - y_SG_eval_pdr[:, k]
            l2_rel_error_pdr[k] = np.sqrt(np.dot(diff_pdr**2, w_pos) / denom_sq)
        else:
            l2_rel_error_pd[k] = np.nan
            l2_rel_error_pdr[k] = np.nan
    
    # Calculate sparsity
    sparsity_pd = [np.count_nonzero(np.abs(xhat_pd_curve[:, k]) > 1e-12) for k in range(K)]
    sparsity_pdr = [np.count_nonzero(np.abs(xhat_pdr_curve[:, k]) > 1e-12) for k in range(K)]
    
    # Store results
    learning_curve_results['l2_errors_pd'].append(l2_rel_error_pd.copy())
    learning_curve_results['l2_errors_pdr'].append(l2_rel_error_pdr.copy())
    learning_curve_results['sparsity_pd'].append(sparsity_pd)
    learning_curve_results['sparsity_pdr'].append(sparsity_pdr)
    learning_curve_results['solve_times_pd'].append(solve_time_pd)
    learning_curve_results['solve_times_pdr'].append(solve_time_pdr)
    
    print(f"L2 Relative Errors:")
    print(f"  PD:  {l2_rel_error_pd}")
    print(f"  PDR: {l2_rel_error_pdr}")
    print(f"Average L2 Error:")
    print(f"  PD:  {np.mean(l2_rel_error_pd):.6f}")
    print(f"  PDR: {np.mean(l2_rel_error_pdr):.6f}")

