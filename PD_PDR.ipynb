    axs[1,0].set_yscale('log')
    axs[1,0].set_xlabel('Basis Index')
    axs[1,0].set_ylabel('Weight × |Coefficient|')
    axs[1,0].set_title(f'Weighted Coefficients: {output_names[k]} (11D: All Parameters)')
    axs[1,0].legend()
    axs[1,0].grid(True, alpha=0.3)
    
    # --- (4) SORTED Weighted Coefficient Decay ---
    axs[1,1].scatter(inds, np.sort(weighted_xhat_SG)[::-1], marker='o', label='Sorted Weighted SG', alpha=0.7, color='red', s=20)
    axs[1,1].scatter(inds, np.sort(weighted_xhat_PD)[::-1], marker='+', label='Sorted Weighted PD', alpha=0.7, color='blue', s=30)
    axs[1,1].scatter(inds, np.sort(weighted_xhat_PDR)[::-1], marker='x', label='Sorted Weighted PDR', alpha=0.7, color='green', s=30)
