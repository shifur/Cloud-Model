final_pd = xhat_pd_curve if 'xhat_pd_curve' in locals() else xhat_pd
final_pdr = xhat_pdr_curve if 'xhat_pdr_curve' in locals() else xhat_pdr

N = N_basis
inds = np.arange(N)

for k in range(K):
